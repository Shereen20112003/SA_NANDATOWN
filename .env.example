# Local configuration only. Never commit a populated .env file.
WORKBENCH_PROVIDER=azure

# Optional coco CLI provider: set WORKBENCH_PROVIDER=coco instead.
# Requires your independently installed and authenticated coco + Claude Code.
COCO_MODEL=claude-haiku-4-5
COCO_EXECUTABLE=

# Use a deployment that supports chat completions and JSON mode (for example GPT-4.1).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Optional second Azure resource. Two deployments on the same host are NOT
# independent resources. Backup is necessary for resource-level failover.
AZURE_OPENAI_BACKUP_ENDPOINT=
AZURE_OPENAI_BACKUP_API_KEY=
AZURE_OPENAI_BACKUP_DEPLOYMENT=
